{
  "name": "uniform-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "seed": "node scripts/seed.mjs",
    "db:local": "wrangler d1 migrations apply LIVE_DB --local && wrangler d1 migrations apply DEMO_DB --local && wrangler d1 execute DEMO_DB --local --file=data/demo-seed.sql",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "postinstall": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "jose": "^5.10.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wrangler": "^4.150.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.5.0"
  }
}